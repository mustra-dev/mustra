# Which mustra release to pull, kept apart from .env so bumping a version never
# opens the file that holds the keys and credentials. Copy to version.env (git
# ignores it) and change the tag to upgrade:
#
#   cp deploy/version.env.example deploy/version.env
#
# then, from the repository root:
#
#   docker compose pull server script-tools
#   docker compose up -d --no-deps --no-build script-tools server
#
# "latest" follows every release; a version (1.5.0) stays put until you change it.
MUSTRA_IMAGE_TAG=latest
