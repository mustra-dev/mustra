# Configuration for the compose stack. Do not edit this file: run ./init.sh,
# which copies it to .env with generated secrets and your LAN address filled
# in. Every MUSTRA_* value here is passed straight through to the server;
# `mustra-server -h` lists them all with their defaults.

# --- Postgres ---
POSTGRES_USER=mustra
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mustra

# --- NATS control-plane credentials ---
# The agent<->server channel carries commands that run as root on every
# managed endpoint. It must not be anonymous.
#
# The server's own password (`openssl rand -base64 32`).
MUSTRA_NATS_SERVER_PASSWORD=change-me-server
# The broker's system-account user (mustra-sys), which the server uses only
# to disconnect an agent whose credential was revoked. init.sh generates it.
# Left empty, NATS starts with a random one and a revoked agent is cut off
# when its authorization expires (within an hour) instead of at once.
MUSTRA_NATS_SYS_PASSWORD=change-me-sys
#
# Agents do not share a password any more: each one enrolls with a token
# from the console and gets a credential of its own, which the server
# checks for the broker through NATS auth callout. These are the callout
# account key: the seed (SA...) stays with the server, the public key
# (A...) goes to the broker. init.sh generates both with
# nats/gen-callout-key.sh.
MUSTRA_NATS_CALLOUT_SEED=
MUSTRA_NATS_CALLOUT_ISSUER=
#
# The legacy shared agent password, kept only on an install that predates
# per-agent identity, so its existing agents keep reporting while they move
# to credentials of their own. Leave empty on a new install. Whether it is
# still accepted is the "Allow legacy shared agent credential" switch in
# Settings.
MUSTRA_NATS_AGENT_PASSWORD=

# The server refuses to start while any password above is still an example
# value. That is deliberate; see internal/server/placeholders.go.

# --- Server / console ---
MUSTRA_HTTP_ADDR=:8080
# Standalone default; Compose sets this to its private script-tools service.
MUSTRA_SCRIPT_TOOLS_URL=http://127.0.0.1:8091
# How long since an agent's last heartbeat before it is shown offline.
# Should be a small multiple of the agent's --heartbeat-interval.
MUSTRA_STALE_AFTER=30s
# How long an agent may stay offline before it is dropped from inventory
# entirely (not just shown offline). Re-registering brings it right back.
MUSTRA_OFFLINE_EXPIRY=1h
MUSTRA_LOG_LEVEL=info

# --- Console auth ---

# Session cookie Secure flag. true (the default) is right whenever the
# console is reached over HTTPS -- a reverse proxy or the cloudflared
# profile -- and also over http://localhost (an SSH tunnel), which browsers
# profile -- and also over http://localhost (an SSH tunnel), which browsers
# treat as secure. Plain http on a LAN isn't supported: a sign-in and any
# enrollment token would cross the network in the clear, and with this true a
# browser won't send the cookie, so the login silently doesn't stick.
MUSTRA_COOKIE_SECURE=true

# Proxies whose X-Forwarded-For / CF-Connecting-IP may be believed for the
# client address (rate limiting, audit). Comma-separated CIDRs, e.g. the
# compose network cloudflared sits on. Empty trusts no forwarded header.
MUSTRA_TRUSTED_PROXIES=
# Origins accepted for state-changing requests when a proxy rewrites Host.
#MUSTRA_TRUSTED_ORIGINS=https://mustra.example.com

# Only for development stacks that deliberately keep example secrets
# (mustra:mustra). Never set on a real deployment.
MUSTRA_ALLOW_PLACEHOLDER_SECRETS=false

# Break-glass local account. Always works, independent of SSO. This is what
# still gets you in if the IdP is down. (The older MUSTRA_BACKDOOR_USERNAME
# / MUSTRA_BACKDOOR_PASSWORD names are still read, with a warning.)
#
# Left empty on purpose. With no account configured the console serves a
# one-time setup page instead of a login. Opening it needs the one-time
# setup link the server prints in its log at first start
# (`docker compose logs server | grep "FIRST-RUN SETUP"`; init.sh --start
# shows it), or MUSTRA_SETUP_TOKEN if you set one. Filling these in
# here skips that page, which is what you want when you are rebuilding a
# deployment from configuration rather than standing a new one up.
MUSTRA_BREAKGLASS_USERNAME=
MUSTRA_BREAKGLASS_PASSWORD=

# Static bearer token an IdP's SCIM provider must present. Leave empty to
# disable SCIM provisioning entirely.
MUSTRA_SCIM_TOKEN=

# OIDC single sign-on (Authentik, Entra, Okta, or any standards-compliant
# IdP). Leave all four empty to disable SSO; the backdoor account still
# works. The redirect URL is https://<your public hostname>/auth/callback.
MUSTRA_OIDC_ISSUER_URL=
MUSTRA_OIDC_CLIENT_ID=
MUSTRA_OIDC_CLIENT_SECRET=
MUSTRA_OIDC_REDIRECT_URL=
# Who may sign in through SSO. With no rule set, SSO sign-in is refused:
# an IdP like Google or Discord would otherwise admit anyone with an account.
# Comma-separated; see Settings -> Identity providers for the same rules.
#MUSTRA_OIDC_ALLOWED_DOMAINS=example.com
#MUSTRA_OIDC_ALLOWED_EMAILS=
#MUSTRA_OIDC_ALLOWED_GROUPS=

# --- Agent deployment (Client Management page) ---

# The console's public base URL, https://host[:port]. Every URL an agent is
# given -- install one-liners, binary and package downloads -- is built
# from it, never from the request's Host header. init.sh fills it from
# --public-hostname, or with http://<LAN address>:8080 for a LAN-only
# install, which needs the development override below. Settable in the
# console (Settings -> Agent identity) instead when this is empty.
MUSTRA_PUBLIC_URL=
# Accept a plain-http public URL. Enrollment tokens and session cookies
# cross it, so use only on a trusted LAN or for development.
MUSTRA_ALLOW_INSECURE_PUBLIC_URL=false

# The ed25519 key agent updates are signed with (base64 32-byte seed).
# Agents pin its public half when they enroll and refuse any update it did
# not sign. init.sh generates it; if empty, the server generates one on
# first start and keeps it in the database (encrypted with the credential
# key below when that is set). For release-signed binaries instead, set
# only MUSTRA_AGENT_SIGNING_PUBKEY and ship <binary>.sig beside each build.
MUSTRA_AGENT_SIGNING_KEY=
#MUSTRA_AGENT_SIGNING_PUBKEY=

# The NATS address the install scripts tell new agents to connect to. Must
# be reachable from the endpoints, so it is this host's LAN address, not the
# in-compose name. init.sh detects it; the TLS certificate must list the
# same address (gen-certs.sh does this).
MUSTRA_AGENT_NATS_URL=

# Hex-encoded 32-byte AES-256 key encrypting the SSH credential vault at
# rest (`openssl rand -hex 32`). Leave empty to disable the vault and
# scan-and-push deploy; manual install via /install.sh still works.
MUSTRA_CREDENTIAL_ENCRYPTION_KEY=

# Your Cloudflare Tunnel config, for the "tunnel" profile. Keep it in
# cloudflared/config.local.yml (ignored by git) so updates never replace it
# with the tracked template; unset uses cloudflared/config.yml.
#MUSTRA_CLOUDFLARED_CONFIG=./cloudflared/config.local.yml

# --- Image (optional) ---
# The tag to pull from ghcr.io/mustra-dev/mustra lives in version.env, beside
# this file, so a version bump never opens the file that holds the keys. See
# version.env.example. A tag set here still works, and version.env overrides it
# when Compose runs from the repository root.

# --- Networks (optional) ---
# Docker chooses each network's subnet from its default address pools. On a
# host that has used them up, `docker compose up` fails with "could not find an
# available, non-overlapping IPv4 address pool": set the subnets here instead.
#MUSTRA_NETWORK_SUBNET=172.30.10.0/24
#MUSTRA_TOOLS_SUBNET=172.30.11.0/24

# Remote desktop through Apache Guacamole (optional; the "remote" compose
# profile). 32 hex characters from `openssl rand -hex 16`, entered again under
# Access → Jump Gate → Remote desktop. Guacamole opens only connections the
# mustra server signs with it.
MUSTRA_GUACAMOLE_JSON_SECRET=
