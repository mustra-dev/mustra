# Build output and local scratch space
bin/
*.exe
*.test
scratch/

# Agent state (the default --data-dir, and its pre-rename name): the
# agent's identity and its outbox. Never commit one.
mustra-agent-data/
beacon-agent-data/

# Environment files hold real secrets. Only the template is tracked.
.env
.env.*
!.env.example

# Cloudflare Tunnel: `cloudflared tunnel create` writes <tunnel-id>.json and
# `cloudflared login` writes cert.pem. Both are credentials.
deploy/cloudflared/creds.json
deploy/cloudflared/*.json
deploy/cloudflared/*.pem
# Your own tunnel config, kept out of the tracked placeholder template.
deploy/cloudflared/config.local.yml

# Key material wherever it lands: TLS keys and bundles, NATS credentials,
# nkey seeds and user JWTs.
*.key
*.pem
*.p12
*.pfx
*.creds
*.nk
*.jwt

# Build artifacts from the placeholder packages
packaging/pypi/dist/
packaging/pypi/src/*.egg-info/
packaging/**/node_modules/

# The e2e browser crawl's Playwright install (npm ci in test/e2e/ui)
test/e2e/ui/node_modules/
test/e2e/artifacts/

# Generated by deploy/init.sh and deploy/nats/gen-certs.sh
deploy/nats/certs/


# Python bytecode.
__pycache__/
*.pyc

# The release to pull (deploy/version.env.example); the operator's own.
deploy/version.env
